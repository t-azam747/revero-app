# Copy to ignored .env. Never place real credentials in this example.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
# Queue limits matched to your free-tier quota. Press "Process now" to override backoff;
# it still waits for a free token. Lower these if you see repeated 429 responses.
GEMINI_RPM=10
GEMINI_RPD=250
GEMINI_BATCH_SIZE=5
GEMINI_MAX_ATTEMPTS=4
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Enable scheduling explicitly in the Digest view after configuring Telegram.

# Instagram Login pilot. No Gemini or Telegram needed for intake.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_SENDER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Copy the supported version selected in your Meta dashboard, including v.
INSTAGRAM_API_VERSION=
# Enable only after enrolling your own test sender's scoped ID.
INSTAGRAM_REPLIES_ENABLED=false

# unified = Business Integration System User token on graph.facebook.com
# instagram = legacy Instagram User token on graph.instagram.com
INSTAGRAM_LOGIN_FLOW=unified
